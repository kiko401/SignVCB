# ===== JWT 鉴权 =====
JWT_SECRET=""

# ===== MySQL =====
MYSQL_HOST="signvcb-mysql"
MYSQL_PORT=3306
MYSQL_USER="signvcb"
MYSQL_PASSWORD=""
MYSQL_DATABASE="signvcb"
MYSQL_ROOT_PASSWORD=""

# ===== Redis =====
REDIS_HOST="signvcb-redis"
REDIS_PORT=6379

# ===== 算法引擎 =====
ALGORITHM_ENGINE_URL="http://signvcb-engine:8001"
ENGINE_HOST="signvcb-engine"
ENGINE_PORT=8001
ENGINE_TIMEOUT=10.0
ENGINE_CONNECT_TIMEOUT=2.0

# ===== 外部服务 API 密钥 =====
TENCENT_ASR_SECRET_ID=""
TENCENT_ASR_SECRET_KEY=""
MINIMAX_API_KEY=""
MINIMAX_GROUP_ID=""
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com/v1"
DEEPSEEK_MODEL="deepseek-v4-flash"

# ===== 业务开关 =====
ENABLE_STREAM_MASKING=true
SHOW_OOV_MAP=true
SHOW_NMM_HINTS=true
SSE_TIMEOUT_MS=10000

# ===== 部署拓扑 =====
SERVER_PUBLIC_HOST="http://localhost:8081"
